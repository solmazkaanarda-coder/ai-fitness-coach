  Alert,
  Image,
  SafeAreaView,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  TouchableOpacity,
  View
} from "react-native";

const API_URL = "http://192.168.1.9:8000";

type Screen =
  | "welcome"
  | "account"
  | "personal"
  | "security"
  | "plan"
  | "theme"
  | "dashboard"
  | "water"
  | "coach"
  | "analysis"
  | "progress"
  | "profile";

type Language = "tr" | "en" | "de" | "ru";

